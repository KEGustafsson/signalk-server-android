<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The server listens on the LAN and installs plugins from npm. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS: the server advertises _signalk-http._tcp and clients find it. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17 local network protection: other devices reaching the server, and mDNS.
         A runtime permission in the Nearby devices group, asked for by LocalNetwork's rules. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- The server runs with the screen off: a foreground service with a partial wake lock. Of
         type connectedDevice only, not dataSync, which Android 15 limits to six hours a day
         (SignalKService says more). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The phone's GNSS for Signal K through the Android bridge (docs/PLAN.md §7.1). Precise
         location while in use only: no ACCESS_BACKGROUND_LOCATION. The service adds the location
         foreground type when the permission is granted, so a server started from the screen keeps
         its fixes with the screen off. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth SPP serial (NMEA 0183 senders, AIS receivers; BluetoothSerial): the paired
         devices the owner chose are dialled. Bluetooth LE (BleScanner): advertisements are
         listened to, for the server's sensors, and nothing is connected to. BLUETOOTH_CONNECT and
         BLUETOOTH_SCAN are asked for together in the Dock (Android 12+); below that the
         install-time BLUETOOTH does the first, BLUETOOTH_ADMIN lets the scan start and precise
         location lets it hear. The scan
         is never used for location, which also leaves out the few beacons Android counts as
         location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" />

    <!-- The boat's alarms (PhoneAlarm): vibration with the alarm sound, and the full-screen alarm
         that wakes a locked phone. Android 14 and later grant the full-screen intent to alarm
         and calling apps only; anywhere else the owner allows it in the settings, from the Dock. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The helm screen's overlay (night.NightFilter): the red night filter, the dimmed screen
         and the screen kept on, over the browser and its webapps. The owner allows it in the
         system's settings, which the Dock's Helm screen card opens. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The app's own update (update.AppUpdater, docs/PLAN.md §10): the APK of a newer release,
         checked, handed to Android's installer, which asks the owner. Android asks once too
         whether the app may install apps at all; the Dock opens that setting. Not used on an
         install a store keeps current (F-Droid, Play). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PocketSK"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <!-- networkSecurityConfig: cleartext for the admin UI and webapps, plain http on
             127.0.0.1 and the LAN as on every Signal K install, and api.github.com pinned for the
             release notes; the file says why. The Node runtime's libraries are extracted at
             install time so lib/<abi>/libnodeexec.so can be exec'd from nativeLibraryDir
             (docs/PLAN.md §4.1, spike R1); jniLibs.useLegacyPackaging in app/build.gradle.kts
             sets that, because AGP no longer takes it from the manifest. -->

        <!-- The Dock and the setup wizard. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- pocketsk://webapp/<package>: a home-screen shortcut or another app opens that
                 webapp in the browser, the server started first when it is stopped (PLAN §8.3).
                 Not BROWSABLE, so a web page cannot start the server by a link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="pocketsk" android:host="webapp" />
            </intent-filter>
            <!-- A USB serial adapter plugged in: Android offers the app, and allowing it allows
                 the bridge the device (UsbSerial). The Dock's coming to the front looks again. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_devices" />
        </activity>

        <!-- The boat's alarm on the whole screen, from the alarm notification's full-screen intent:
             over the lock screen, the screen turned on, in a task of its own so the Dock does
             not come up with it. -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <service
            android:name=".server.SignalKService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- The Quick Settings tile: bound by the system UI only, which holds the permission. -->
        <service
            android:name=".server.ServerTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- The night filter's Quick Settings tile (night.NightTile): bound by the system UI only. -->
        <service
            android:name=".night.NightTile"
            android:exported="true"
            android:icon="@drawable/ic_night"
            android:label="@string/night_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Exported for the system's broadcasts; the permission keeps every other sender out. -->
        <receiver
            android:name=".server.BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- What Android's installer says of the app's own update (update.UpdateReceiver),
             through the PendingIntent the app gives it; not exported. -->
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />

        <!-- The boat widget (widget.BoatWidget): depth, speed over ground and the apparent wind on
             the home screen. Not exported: the system delivers a widget's own broadcasts to it all
             the same, and nothing else has reason to send them. -->
        <receiver
            android:name=".widget.BoatWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_boat_info" />
        </receiver>

        <!-- The diagnostics bundle, handed to the app the owner picks in the share sheet for that
             one share (res/xml/shared_files.xml); not exported, so nothing else can ask for it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
