<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and earlier (fullBackupContent). The app's own SharedPreferences hold the admin
  token for the local server; the server's own state under files/home/.signalk holds every
  plugin's secrets (security.json, tokens, API keys). None of it belongs in a cloud backup;
  the Dock's explicit backup/restore to a file the user chooses is the way to move it. files/npm,
  files/bin, files/prebuilds, files/plugins (the Android bridge's plugin) and files/runtime (the
  preload every node loads) are the APK's own and made again on the next start; files/bridge.sock is the bridge's socket, nothing to keep. files/logs is
  the server's output, which is this phone's story and may carry whatever a plugin printed.
  The data folders the owner may move to an SD card or USB drive (DataStore) are in the app's
  folder on that card, which neither backup nor device transfer takes. The USB inbox (Inbox) is in
  the app's folder on the phone's shared storage, the external domain, and stays on this phone.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="home" />
    <exclude domain="file" path="sk" />
    <exclude domain="file" path="npm" />
    <exclude domain="file" path="bin" />
    <exclude domain="file" path="prebuilds" />
    <exclude domain="file" path="logs" />
    <exclude domain="file" path="plugins" />
    <exclude domain="file" path="runtime" />
    <exclude domain="file" path="bridge.sock" />
    <exclude domain="external" path="." />
</full-backup-content>
