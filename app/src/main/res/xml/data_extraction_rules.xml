<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later. Same reasoning as backup_rules.xml: the admin token in the default
  SharedPreferences and the whole server state (files/home/.signalk with security.json and every
  plugin's credentials, files/sk with the installed server) stay on this phone. Cloud backup is
  off anyway (allowBackup="false"); device transfer is not, so these rules are what keeps a boat's
  credentials from riding along to a new phone unasked. The preferences file name is what
  PreferenceManager.getDefaultSharedPreferences uses: <package>_preferences.xml.
  files/npm, files/bin and files/prebuilds hold nothing of the boat's: the APK unpacks or fetches
  them again, and files/bin/node points into the old install's nativeLibraryDir, which a new
  phone does not have. files/logs is the server's output, this phone's story, and may carry
  whatever a plugin printed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="fi.pocketsk_preferences.xml" />
        <exclude domain="file" path="home" />
        <exclude domain="file" path="sk" />
        <exclude domain="file" path="npm" />
        <exclude domain="file" path="bin" />
        <exclude domain="file" path="prebuilds" />
        <exclude domain="file" path="logs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="fi.pocketsk_preferences.xml" />
        <exclude domain="file" path="home" />
        <exclude domain="file" path="sk" />
        <exclude domain="file" path="npm" />
        <exclude domain="file" path="bin" />
        <exclude domain="file" path="prebuilds" />
        <exclude domain="file" path="logs" />
    </device-transfer>
</data-extraction-rules>
