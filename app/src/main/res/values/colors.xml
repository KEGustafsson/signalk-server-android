<resources>
    <!-- Deep sea blue on near-black: readable at the helm at night, and not Signal K's own teal,
         so the native Dock is told apart from the admin UI in the browser at a glance. -->
    <color name="primary">#7FB8FF</color>
    <color name="on_primary">#00315F</color>
    <color name="surface">#0E1218</color>
    <color name="on_surface">#E3E6EA</color>
    <color name="icon_background">#0E2A4A</color>
    <!-- The surface, at 85 % over the wallpaper, for the boat widget. -->
    <color name="widget_background">#D90E1218</color>
    <!-- The Dock's layers, lifted from the surface in the same blue, rather than Material's
         default grey-violet, so cards and the bottom bar read as one sea. -->
    <color name="surface_lowest">#0A0D12</color>
    <color name="surface_low">#121820</color>
    <color name="surface_container">#161D26</color>
    <color name="surface_high">#1C2430</color>
    <color name="surface_highest">#232D3A</color>
    <color name="secondary_container">#1F3A5C</color>
    <color name="on_secondary_container">#D3E4FF</color>
    <color name="outline">#5D6875</color>
    <!-- Secondary lines (a row's summary, a note) in the same blue-grey family. -->
    <color name="on_surface_variant">#A9B4C2</color>
    <!-- The Home ring: running, on its way (starting, waiting, stopping) and stopped. A failure
         takes the theme's error colour. -->
    <color name="state_running">#6FD08C</color>
    <color name="state_busy">#FFB95C</color>
    <color name="state_stopped">#8A939E</color>
</resources>
